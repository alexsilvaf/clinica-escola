{
  "globs": ["**/*.md"],
  "ignores": [
    ".git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.angular/**",
    "**/.gradle/**",
    "documentacao/design/figma.local.md",
    "documentacao/design/telas-modais-restantes.md",
    "documentacao/design/componentes-restantes.md",
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["details", "summary"] },
  },
}
